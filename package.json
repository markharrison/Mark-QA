{
  "name": "mark-qa",
  "version": "1.0.0",
  "description": "Playwright regression tests for the UK Alarms Map",
  "scripts": {
    "test": "playwright test",
    "start": "live-server src --host=127.0.0.1 --port=8080 --no-browser",
    "test:headed": "playwright test --headed",
    "test:report": "playwright show-report"
  },
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "leaflet": "1.9.4",
    "live-server": "1.2.2"
  },
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "live-server": {
      "chokidar": "3.6.0",
      "http-auth": "4.2.1"
    },
    "http-auth": {
      "uuid": "11.1.1"
    }
  }
}
